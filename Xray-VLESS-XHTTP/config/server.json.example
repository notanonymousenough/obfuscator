{
  "log": {"loglevel": "warning"},
  "inbounds": [{
    "tag": "in-gateway", "listen": "127.0.0.1", "port": 8443,
    "protocol": "vless",
    "settings": {"clients": [{"id": "__CLIENT_UUID__"}], "decryption": "none"},
    "streamSettings": {"network": "xhttp", "security": "none", "xhttpSettings": {"path": "__XHTTP_PATH__", "mode": "stream-up"}}
  }],
  "outbounds": [
    {"tag": "direct", "protocol": "freedom", "settings": {"domainStrategy": "UseIPv4"}},
    {"tag": "block", "protocol": "blackhole", "settings": {}}
  ],
  "routing": {"domainStrategy": "IPIfNonMatch", "rules": [{"type": "field", "ip": ["geoip:private"], "outboundTag": "block"}]}
}
