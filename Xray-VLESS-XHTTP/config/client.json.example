{
  "log": {"loglevel": "warning"},
  "inbounds": [{"tag": "local-socks", "listen": "127.0.0.1", "port": 1080, "protocol": "socks", "settings": {"auth": "noauth", "udp": true}}],
  "outbounds": [{
    "tag": "de2", "protocol": "vless",
    "settings": {"vnext": [{"address": "__DOMAIN__", "port": 443, "users": [{"id": "__CLIENT_UUID__", "encryption": "none"}]}]},
    "streamSettings": {
      "network": "xhttp", "security": "tls",
      "tlsSettings": {"serverName": "__DOMAIN__", "alpn": ["h2"], "fingerprint": "chrome"},
      "xhttpSettings": {"path": "__XHTTP_PATH__", "mode": "stream-up"}
    }
  }]
}
