[Unit]
Description=Obfuscator Cloudflare DNS update
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/lib/obfuscator/cloudflare_dns.py --config /etc/obfuscator/dns.json --apply
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
TimeoutStartSec=90
